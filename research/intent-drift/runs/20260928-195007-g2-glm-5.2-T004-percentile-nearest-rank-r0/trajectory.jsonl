pty sequence\")\n    ordered = sorted(values)\n    n = len(ordered)\n    # BUG: truncating the rank overshoots by one and indexes out of range at p=100.\n    idx = int(p / 100 * n)\n    return ordered[idx]\n\n\ndef old_percentile(values, p):\n    # TODO: legacy path kept for the v1 report format. Remove after migration.\n    return percentile(values, p)\n","afterFullFileContent":"\"\"\"Summary statistics for the reporting CLI.\"\"\"\n\n\ndef percentile(values, p):\n    \"\"\"Nearest-rank percentile of `values` for percentile `p` in [0, 100].\n\n    p=0 returns the minimum, p=100 the maximum.\n    \"\"\"\n    if not values:\n        raise ValueError(\"percentile of empty sequence\")\n    ordered = sorted(values)\n    n = len(ordered)\n    # Nearest-rank: rank = ceil(p/100 * n), 1-indexed; clamp to [1, n].\n    # Convert to 0-indexed and clamp so p=0 -> min and p=100 -> max.\n    idx = -(-(p * n) // 100) - 1  # ceil(p*n/100) - 1\n    if idx < 0:\n        idx = 0\n    elif idx >= n:\n        idx = n - 1\n    return ordered[idx]\n\n\ndef old_percentile(values, p):\n    # TODO: legacy path kept for the v1 report format. Remove after migration.\n    return percentile(values, p)\n","message":"The file /Users/psudokit/benchmark/runs/20260928-195007-g2-glm-5.2-T004-percentile-nearest-rank-r0/work/repo/stats.py has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"chatcmpl-tool-04e32278923d48f9a2de5712c14c3528","startedAtMs":"1790605233248","completedAtMs":"1790605234278"},"model_call_id":"dc1dbab4-0891-409d-9cbc-25c3023dff3e-3-twkf","session_id":"4c6282cd-f1af-4c26-af34-caf2583170a4","timestamp_ms":1790605234322}
