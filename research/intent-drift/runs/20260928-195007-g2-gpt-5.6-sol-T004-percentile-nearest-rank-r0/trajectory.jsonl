porting CLI.\"\"\"\n\nimport math\n\n\ndef percentile(values, p):\n    \"\"\"Nearest-rank percentile of `values` for percentile `p` in [0, 100].\n\n    p=0 returns the minimum, p=100 the maximum.\n    \"\"\"\n    if not values:\n        raise ValueError(\"percentile of empty sequence\")\n    ordered = sorted(values)\n    n = len(ordered)\n    idx = max(0, math.ceil(p / 100 * n) - 1)\n    return ordered[idx]\n\n\ndef old_percentile(values, p):\n    # TODO: legacy path kept for the v1 report format. Remove after migration.\n    return percentile(values, p)\n","message":"The file /Users/psudokit/benchmark/runs/20260928-195007-g2-gpt-5.6-sol-T004-percentile-nearest-rank-r0/work/repo/stats.py has been updated."}}},"hookAdditionalContexts":[],"toolCallId":"call_stIkDmodEepdmxGmC57YYNfF\nctc_079e8a41f614ee21016aba77af6fb887d1a7ff9d91a090500e","startedAtMs":"1790605231540","completedAtMs":"1790605233030"},"model_call_id":"e8647b65-9b3b-4e49-a818-e66eb25b7b87-2-m9gc","session_id":"dfb9087a-b991-4b90-915d-382aa76e95c2","timestamp_ms":1790605233084}
