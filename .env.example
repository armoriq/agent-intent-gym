# Copy to .env. Existing process variables take precedence. Never commit .env.
ARMORIQ_API_KEY=
ARMORIQ_USER_EMAIL=
# Match the identity.agent_id used by the Python CLI registration config.
ARMORIQ_AGENT_ID=
# Blank endpoints use the installed SDK defaults. Set these for your test backend.
ARMORIQ_IAP_ENDPOINT=
ARMORIQ_BACKEND_ENDPOINT=
ARMORIQ_PROXY_ENDPOINT=
ARMORIQ_SDK_MODE=sdk

# Native benchmark agent: ollama or chat-completions.
MODEL_PROTOCOL=ollama
MODEL_NAME=qwen2.5:3b
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_API_KEY=
# Local gym tool-calling agent always uses the compatible /chat/completions API.
MODEL_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# Optional keys for your own agent adapters.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required only if serving the workbench on a non-loopback interface.
INTENTBENCH_API_TOKEN=
